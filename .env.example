# Docker Environment Variables
# Copy this file to .env and fill in your values

# Admin Panel Password
ADMIN_PASSWORD=visuworks2026

# SMTP Configuration (Contact Form)
IONOS_SMTP_HOST=smtp.ionos.de
IONOS_SMTP_PORT=587
IONOS_SMTP_USER=info@visuworks.de
IONOS_SMTP_PASS="your-smtp-password"
CONTACT_TO_EMAIL=info@visuworks.de
CONTACT_FROM_EMAIL=info@visuworks.de

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://visuworks.de

# Frontend API URL
REACT_APP_BACKEND_URL=http://localhost:8001
